[
  {
    "label": "Build & Debug Lox",
    "adapter": "CodeLLDB",
    "build": {
      "command": "cargo",
      "args": ["build"]
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/lox",
    "args": ["examples/closure.lx"],
    "sourceLanguages": ["rust"],
    "request": "launch"
  }
]
